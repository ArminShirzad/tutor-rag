# ---------------------------------------------------------------------------
# All optional. With no .env at all the system runs fully local and offline:
# local embeddings + extractive (non-generative) answering.
# ---------------------------------------------------------------------------

# Generation. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Providers
EMBED_PROVIDER=local          # local | gemini
LLM_PROVIDER=auto             # auto | gemini | extractive
LLM_MODEL=gemini-2.0-flash

# Chunking
CHUNK_STRATEGY=recursive      # fixed | sentence | recursive | structural
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
RETRIEVAL_MODE=hybrid         # vector | bm25 | hybrid
CANDIDATE_K=20                # retrieved before reranking
FINAL_K=5                     # kept after reranking
USE_RERANKER=true
RRF_K=60
MIN_SCORE=-5.0                # refusal threshold; see scripts/calibrate_threshold.py

# Generation params
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
