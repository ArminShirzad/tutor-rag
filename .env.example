# ---------------------------------------------------------------------------
# All optional. With no .env at all the system runs fully local and offline:
# local embeddings + extractive (non-generative) answering.
# ---------------------------------------------------------------------------

# Generation. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Providers
EMBED_PROVIDER=local          # local | gemini
LLM_PROVIDER=auto             # auto | gemini | extractive
# flash-lite, not flash: the free tier caps the full flash models at 20
# generation requests PER DAY, which is not even enough to run the eval once.
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Chunking
CHUNK_STRATEGY=recursive      # fixed | sentence | recursive | structural
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
RETRIEVAL_MODE=hybrid         # vector | bm25 | hybrid
CANDIDATE_K=20                # retrieved before reranking
FINAL_K=5                     # kept after reranking
USE_RERANKER=true
RERANK_PROVIDER=auto          # auto | cross-encoder | llm | lexical
RRF_K=60
MIN_SCORE=-5.0                # refusal threshold; see scripts/calibrate_threshold.py

# Generation params
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Reliability. See app/resilience.py.
LLM_RPM=5                     # min-interval spacing; 0 disables. Free tier = 5/min
LLM_MAX_RETRIES=4
EMBED_RPM=0                   # embedding quota is separate and usually higher

# Cost estimation, per million tokens. Override to match your actual rates --
# published prices change and a hardcoded constant goes stale silently.
PRICE_IN_PER_M=0.10
PRICE_OUT_PER_M=0.40
